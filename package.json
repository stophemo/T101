{
  "name": "T101",
  "version": "0.0.3",
  "description": "对局数据与 BP 分析终端工具（数据源：101.qq.com 官方）",
  "type": "module",
  "bin": {
    "t101": "./bin/t101.mjs"
  },
  "scripts": {
    "t101": "tsx src/cli.ts",
    "panel": "tsx src/cli.ts panel",
    "panel:build": "cd desktop && npx tauri build --no-bundle",
    "panel:bundle": "cd desktop && npx tauri build --bundles nsis",
    "panel:sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1",
    "panel:verify": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -Verify -Identity https://github.com/stophemo/T101/.github/workflows/build-sign.yml@refs/heads/master",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
