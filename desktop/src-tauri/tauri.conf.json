{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "t101-panel",
  "version": "0.1.0",
  "identifier": "com.t101.panel",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:8765/?side=1",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "T101 · 对局助手",
        "url": "index.html",
        "width": 400,
        "height": 900,
        "minWidth": 300,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
